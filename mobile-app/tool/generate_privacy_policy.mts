// Regenerates lib/features/profile/presentation/privacy_policy_text.dart from
// the website's policy (src/constants/privacyPolicy.ts), so the app and
// souq-elsyrat.com/privacy always show the same text.
//
// Run from the repository root:
//   npx tsx mobile-app/tool/generate_privacy_policy.mts
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { privacyPolicy, PRIVACY_POLICY_UPDATED } from "../../src/constants/privacyPolicy";

const here = path.dirname(fileURLToPath(import.meta.url));
const target = path.join(here, "..", "lib", "features", "profile", "presentation", "privacy_policy_text.dart");

const str = (s: string) => `'${s.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\$/g, "\\$")}'`;
const list = (items: string[], indent: string) => `[\n${items.map((i) => `${indent}  ${str(i)},`).join("\n")}\n${indent}]`;

let out = "// GENERATED by mobile-app/tool/generate_privacy_policy.mts from\n// src/constants/privacyPolicy.ts (the website policy at /privacy). Do not edit.\n";
out += "import 'privacy_policy_model.dart';\n\n";
out += `const privacyPolicyUpdated = ${str(PRIVACY_POLICY_UPDATED)};\n`;
for (const lang of ["ar", "en"] as const) {
  const p = privacyPolicy[lang];
  out += `\nconst privacyPolicy${lang.toUpperCase()} = PolicyDocument(\n  title: ${str(p.title)},\n  updatedLabel: ${str(p.updated)},\n  intro: ${str(p.intro)},\n  sections: [\n`;
  for (const s of p.sections) {
    out += `    PolicySection(\n      title: ${str(s.title)},\n`;
    if (s.paragraphs) out += `      paragraphs: ${list(s.paragraphs, "      ")},\n`;
    if (s.bullets) out += `      bullets: ${list(s.bullets, "      ")},\n`;
    if (s.notes) out += `      notes: ${list(s.notes, "      ")},\n`;
    out += "    ),\n";
  }
  out += "  ],\n);\n";
}
fs.writeFileSync(target, out);
console.log(`Wrote ${path.relative(process.cwd(), target)} (${privacyPolicy.ar.sections.length} sections)`);
