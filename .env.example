# Copy to .env for local development. Never commit .env.
# In production set these in the hosting platform's variable settings instead.

# ---------------------------------------------------------------------------
# Required in production (the server refuses to start without them)
# ---------------------------------------------------------------------------

# NODE_ENV: "production" on the server. Leave unset locally.
# NODE_ENV="production"

# JWT_SECRET: signs login tokens. Random, at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave empty locally: development then uses a throwaway secret per run.
JWT_SECRET=""

# BREVO_API_KEY: Brevo transactional email API key (starts with "xkeysib-").
# This is NOT the SMTP key ("xsmtpsib-"). Without it, development only logs
# that an email would be sent; no email is delivered.
BREVO_API_KEY=""

# BREVO_SENDER_EMAIL / BREVO_SENDER_NAME: "from" identity for OTP emails.
# The address must be a verified sender (or on an authenticated domain) in Brevo.
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Souq Cars"

# ---------------------------------------------------------------------------
# Storage (production: point both at a persistent volume, e.g. /data)
# ---------------------------------------------------------------------------

# DATABASE_PATH: SQLite database file. Default: ./automarket.db
# DATABASE_PATH="/data/automarket.db"

# UPLOADS_DIR: uploaded car photos, reels and part photos. Default: ./uploads
# UPLOADS_DIR="/data/uploads"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# ADMIN_EMAIL / ADMIN_PASSWORD: creates the first administrator account at
# startup if no account with that email exists. Password: 12+ characters.
# Remove ADMIN_PASSWORD from the environment once the account exists.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_PASSWORD_FORCE_RESET: "true" replaces an existing admin's password
# with ADMIN_PASSWORD on the next start (use once, then unset).
# ADMIN_PASSWORD_FORCE_RESET=""

# CORS_ORIGINS: comma-separated browser origins allowed to call the API from
# another site (https only in production). Not needed for the website served
# by this server or for the mobile apps.
# CORS_ORIGINS="https://www.example.com"

# TRUST_PROXY: number of reverse proxies in front of the server. Defaults to
# 1 in production (Railway/Render/Fly), off in development.
# TRUST_PROXY="1"

# PORT: listening port (the platform usually sets this). Default: 3000
# PORT="3000"

# GEMINI_API_KEY: enables the AI search features. Leave empty to disable.
GEMINI_API_KEY=""

# RECAPTCHA_SECRET / VITE_RECAPTCHA_SITE_KEY: Google reCAPTCHA v2 for the
# website's auth forms. Leave RECAPTCHA_SECRET unset unless every client sends
# a captcha token — the mobile apps do not, and would be locked out.
# RECAPTCHA_SECRET=""
# VITE_RECAPTCHA_SITE_KEY=""

# SEED_DEMO_DATA: "true" fills a completely EMPTY database with the demo
# dealers and cars. It never touches a database that already has data, so it
# only has an effect on the very first start. In production an empty database
# needs an explicit choice: "true" (demo catalogue) or "false" (start empty);
# otherwise the server stops, because an unexpectedly empty database usually
# means the persistent volume is not attached.
# SEED_DEMO_DATA="true"
